{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@contracts/*": ["./packages/contracts/src/*"],
      "@tenant-context/*": ["./packages/tenant-context/src/*"],
      "@audit/*": ["./packages/audit/src/*"]
    }
  },
  "exclude": ["node_modules", ".venv", "vendor", "reference-ui", "apps"]
}
